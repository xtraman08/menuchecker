# Copy to .env (npm run setup does this) and fill in ANTHROPIC_API_KEY.
# Never commit .env.

# Postgres (docker compose `db` service). Host-side URLs use localhost;
# inside compose the api/migrate services override the host to `db`.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://fare_app:fare_app@localhost:5432/fare
DATABASE_MIGRATE_URL=postgres://fare_owner:fare_owner@localhost:5432/fare

# API
JWT_SECRET=change-me
API_PORT=4000
RATE_LIMIT_SCAN_PER_HOUR=20
MAX_UPLOAD_BYTES=8000000

# Claude API (server-side only; never exposed to the app)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Mobile / web app
EXPO_PUBLIC_API_URL=http://localhost:4000

# Host ports used by docker compose
WEB_PORT=8080

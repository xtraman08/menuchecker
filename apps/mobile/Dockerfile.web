# syntax=docker/dockerfile:1
# Expo web build (`expo export -p web`) served by nginx.
# Build context: repository root (see docker-compose.yml).
# EXPO_PUBLIC_API_URL is inlined into the JS bundle at build time, so it must be
# the API URL as seen from the *browser* (e.g. http://localhost:4000).

FROM node:24-slim AS build
WORKDIR /repo
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY db/package.json db/
COPY services/api/package.json services/api/
COPY apps/mobile/package.json apps/mobile/
COPY e2e/package.json e2e/
RUN --mount=type=cache,target=/root/.npm \
    npm ci -w @fare/mobile -w @fare/shared --include-workspace-root=false --no-audit --no-fund
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/mobile apps/mobile
ARG EXPO_PUBLIC_API_URL=http://localhost:4000
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL} \
    NODE_ENV=production \
    CI=1
WORKDIR /repo/apps/mobile
RUN npx expo export -p web --output-dir dist

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY apps/mobile/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/mobile/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

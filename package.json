{
  "name": "fare",
  "version": "0.1.0",
  "private": true,
  "description": "Fare - menu comprehension & match app (monorepo)",
  "workspaces": [
    "packages/*",
    "db",
    "services/*",
    "apps/*",
    "e2e"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node scripts/e2e.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "npm run migrate -w db",
    "db:seed": "npm run seed -w db",
    "db:reset": "node scripts/reset-db.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0"
  }
}

    "@fastify/multipart": "^9.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "sharp": "^0.34.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
